# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Local MongoDB by default. Swap in a MongoDB Atlas URI if you don't run Mongo locally.
MONGO_URI=mongodb://127.0.0.1:27017/firstdraft

# Port the Express API listens on.
PORT=5000

# Model used by both agents. gemini-flash-latest is a free-tier-friendly alias
# that always points at Google's current Flash model, so you don't need to
# update this when Google retires an older model version.
GEMINI_MODEL=gemini-flash-latest
